"}, {"database": "cde_development", "identifier": "dbt_seeds", "schema": "elementary"}, {"database": "cde_development", "identifier": "monitors_runs", "schema": "elementary"}, {"database": "cde_development", "identifier": "dbt_sources", "schema": "elementary"}, {"database": "cde_development", "identifier": "alerts_dbt_models", "schema": "elementary"}, {"database": "cde_development", "identifier": "metrics_anomaly_score", "schema": "elementary"}, {"database": "cde_development", "identifier": "metadata", "schema": "elementary"}, {"database": "cde_development", "identifier": "dbt_run_results", "schema": "elementary"}, {"database": "cde_development", "identifier": "dbt_tests", "schema": "elementary"}, {"database": "cde_development", "identifier": "alerts_dbt_source_freshness", "schema": "elementary"}], "schema": "elementary"}, "info": {"category": "", "code": "E014", "extra": {}, "invocation_id": "572bf9b3-9938-48a4-ab70-fa6815d35313", "level": "debug", "msg": "While listing relations in database=cde_development, schema=elementary, found: seed_run_results, anomaly_threshold_sensitivity, job_run_results, dbt_columns, test_result_rows, model_run_results, dbt_artifacts_hashes, dbt_groups, alerts_dbt_tests, alerts_schema_changes, data_monitoring_metrics, elementary_test_results, dbt_source_freshness_results, alerts_anomaly_detection, dbt_invocations, dbt_snapshots, dbt_metrics, schema_columns_snapshot, dbt_exposures, snapshot_run_results, dbt_models, dbt_seeds, monitors_runs, dbt_sources, alerts_dbt_models, metrics_anomaly_score, metadata, dbt_run_results, dbt_tests, alerts_dbt_source_freshness", "name": "ListRelations", "pid": 80796, "thread": "MainThread", "ts": "2026-10-20T12:48:41.719061Z"}}

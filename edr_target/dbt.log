{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"a6b37f5e-7647-4501-a339-5ea90328b082\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"a6b37f5e-7647-4501-a339-5ea90328b082\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with model_runs as (\n            select\n                *,\n                row_number() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from `cde_development`.`elementary`.`model_run_results`\n        )\n\n        select\n            unique_id,\n            invocation_id,\n            name,\n            schema_name as schema,\n            status,\n            case\n                when status != 'success' then 0\n                else round(cast(execution_time as decimal(28,6)), 1)\n            end as execution_time,\n            full_refresh,\n            materialization,\n            case when invocations_rank_index = 1 then compiled_code else NULL end as compiled_code,\n            generated_at\n        from model_runs\n        where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(generated_at as timestamp)), nvl2(date(cast(generated_at as timestamp)), assert_true(date(cast(generated_at as timestamp)) is not null), null))\n\n) < 7\n        \n          and unique_id not like 'model.elementary.%'\n        \n        order by generated_at\n    \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "a6b37f5e-7647-4501-a339-5ea90328b082", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"a6b37f5e-7647-4501-a339-5ea90328b082\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"a6b37f5e-7647-4501-a339-5ea90328b082\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with model_runs as (\n            select\n                *,\n                row_number() over (partition by unique_id order by generated_at desc) as invocations_rank_index\n            from `cde_development`.`elementary`.`model_run_results`\n        )\n\n        select\n            unique_id,\n            invocation_id,\n            name,\n            schema_name as schema,\n            status,\n            case\n                when status != 'success' then 0\n                else round(cast(execution_time as decimal(28,6)), 1)\n            end as execution_time,\n            full_refresh,\n            materialization,\n            case when invocations_rank_index = 1 then compiled_code else NULL end as compiled_code,\n            generated_at\n        from model_runs\n        where \n        \n        datediff(\n\n    coalesce(date(\n    current_timestamp::timestamp\n), nvl2(date(\n    current_timestamp::timestamp\n), assert_true(date(\n    current_timestamp::timestamp\n) is not null), null))\n\n, \n\n    coalesce(date(cast(generated_at as timestamp)), nvl2(date(cast(generated_at as timestamp)), assert_true(date(cast(generated_at as timestamp)) is not null), null))\n\n) < 7\n        \n          and unique_id not like 'model.elementary.%'\n        \n        order by generated_at\n    \n\n  ", "name": "SQLQuery", "pid": 80230, "thread": "MainThread", "ts": "2026-10-20T12:29:31.748299Z"}}

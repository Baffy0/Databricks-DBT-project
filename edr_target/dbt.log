{"data": {"msg": "Elementary: --ELEMENTARY-MACRO-OUTPUT-START--[{\"unique_id\": \"model.cde_marketing_ad.fct_social_ads\", \"invocation_id\": \"67be3f51-f833-40d2-9fc3-8952e9c29889\", \"name\": \"fct_social_ads\", \"schema\": \"ads_mart\", \"status\": \"success\", \"execution_time\": 216.3, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"\\n\\n\\nWITH facebook AS (\\n    SELECT \\n        ad_date,\\n        ad_id,\\n        campaign_name,\\n        ad_group_name,\\n        ad_name,\\n        ad_currency_code,\\n        CAST(spend AS DECIMAL(18,2)) AS spend,\\n        CAST(impressions AS INT) AS impressions,\\n        CAST(ad_clicks AS INT) AS ad_clicks,\\n        data_src\\n    FROM `cde_development`.`ads_intermediate`.`int_facebook_ads`\\n),\\n\\nsnapchat AS (\\n    SELECT \\n        ad_date,\\n        ad_id,\\n        campaign_name,\\n        ad_group_name,\\n        ad_name,\\n        ad_currency_code,\\n        CAST(spend AS DECIMAL(18,2)) AS spend,\\n        CAST(impressions AS INT) AS impressions,\\n        CAST(ad_clicks AS INT) AS ad_clicks,\\n        data_src\\n    FROM `cde_development`.`ads_intermediate`.`int_snapchat_ads`\\n)\\n\\nSELECT * FROM facebook\\nUNION ALL\\nSELECT * FROM snapchat\", \"generated_at\": \"2026-10-20 00:34:18\"}, {\"unique_id\": \"model.cde_marketing_ad.int_facebook_ads\", \"invocation_id\": \"67be3f51-f833-40d2-9fc3-8952e9c29889\", \"name\": \"int_facebook_ads\", \"schema\": \"ads_intermediate\", \"status\": \"success\", \"execution_time\": 681.7, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"\\n\\nWITH fs AS (\\n    SELECT *\\n    FROM `cde_development`.`ads_staging`.`stg_facebook_ads_stats`\\n),\\n\\nfn AS (\\n    SELECT *\\n    FROM `cde_development`.`ads_staging`.`stg_facebook_ad_names`\\n),\\n\\nfg AS (\\n    SELECT *\\n    FROM `cde_development`.`ads_staging`.`stg_facebook_ad_group`\\n),\\n\\nfc AS (\\n    SELECT *\\n    FROM `cde_development`.`ads_staging`.`stg_facebook_campaign`\\n),\\n\\nfa AS (\\n    SELECT *\\n    FROM `cde_development`.`ads_staging`.`stg_facebook_new_account`\\n)\\n\\nselect \\nfs.ad_date,\\nfs.ad_id,\\nfc.campaign_name,\\nfg.ad_group_name,\\nfn.ad_name,\\nfa.ad_currency_code,\\nfs.spend,\\nfs.impressions,\\nfs.ad_clicks,\\n'facebook' as data_src\\nfrom stg_facebook_ads_stats fs\\nleft join stg_facebook_new_account fa\\non fs.account_id = fa.account_id\\nleft join stg_facebook_ad_names fn\\non fa.account_id = fn.account_id\\nleft join stg_facebook_ad_group fg\\non fn.ad_group_id = fg.ad_group_id\\nleft join stg_facebook_campaign fc\\non fn.campaign_id = fc.campaign_id\", \"generated_at\": \"2026-10-20 00:34:18\"}, {\"unique_id\": \"model.cde_marketing_ad.int_snapchat_ads\", \"invocation_id\": \"67be3f51-f833-40d2-9fc3-8952e9c29889\", \"name\": \"int_snapchat_ads\", \"schema\": \"ads_intermediate\", \"status\": \"success\", \"execution_time\": 7.1, \"full_refresh\": false, \"materialization\": \"table\", \"compiled_code\": \"\\n\\nWITH ss AS (\\n    SELECT *\\n    FROM `cde_development`.`ads_staging`.`stg_snapchat_ads_stats`\\n),\\n\\nsn AS (\\n    SELECT *\\n    FROM `cde_development`.`ads_staging`.`stg_snapchat_ad_names`\\n),\\n\\nsg AS (\\n    SELECT *\\n    FROM `cde_development`.`ads_staging`.`stg_snapchat_ad_group`\\n),\\n\\nsc AS (\\n    SELECT *\\n    FROM `cde_development`.`ads_staging`.`stg_snapchat_ads_campaign`\\n)\\n\\nSELECT\\n    ss.ad_date,\\n    ss.ad_detail_id AS ad_id,\\n    sc.campaign_name,\\n    sg.ad_group_name,\\n    sn.ad_name,\\n    ss.ad_currency_code,\\n    ss.spend,\\n    ss.impressions,\\n    ss.ad_clicks,\\n    ss.data_src\\nFROM ss\\nLEFT JOIN sn\\n    ON ss.ad_detail_id = sn.ad_id\\nLEFT JOIN sg\\n    ON sn.ad_group_id = sg.ad_group_id\\nLEFT JOIN sc\\n    ON sg.campaign_id = sc.campaign_id\", \"generated_at\": \"2026-10-20 00:34:18\"}, {\"unique_id\": \"model.cde_marketing_ad.stg_facebook_ad_group\", \"invocation_id\": \"67be3f51-f833-40d2-9fc3-8952e9c29889\", \"name\": \"stg_facebook_ad_group\", \"schema\": \"ads_staging\", \"status\": \"success\", \"execution_time\": 3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n\\nwith raw_source as (\\n    select * from `bronze_production`.`cdc_staging`.`raw_facebook_ad_group`\\n)\\n\\nSelect \\nad_group_id,\\nad_group_name,\\nCAST(ad_group_updated_at as TIMESTAMP_NTZ) AS ad_group_updated_at\\nfrom raw_source\", \"generated_at\": \"2026-10-20 00:34:18\"}, {\"unique_id\": \"model.cde_marketing_ad.stg_facebook_ad_names\", \"invocation_id\": \"67be3f51-f833-40d2-9fc3-8952e9c29889\", \"name\": \"stg_facebook_ad_names\", \"schema\": \"ads_staging\", \"status\": \"success\", \"execution_time\": 3.8, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n\\nwith raw_source as (\\n    select * from `bronze_production`.`cdc_staging`.`raw_facebook_ad_names`\\n)\\n\\nselect * from raw_source\", \"generated_at\": \"2026-10-20 00:34:18\"}, {\"unique_id\": \"model.cde_marketing_ad.stg_facebook_ads_stats\", \"invocation_id\": \"67be3f51-f833-40d2-9fc3-8952e9c29889\", \"name\": \"stg_facebook_ads_stats\", \"schema\": \"ads_staging\", \"status\": \"success\", \"execution_time\": 3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n\\n\\nwith raw_source as (\\n    select * from `bronze_production`.`cdc_staging`.`raw_facebook_ads_stats`\\n)\\n\\n\\nSELECT\\n    cast(ad_id as string) as ad_id,\\n    account_id,\\n    CAST(ad_spend AS DECIMAL(10,2)) AS spend,\\n\\n    CAST(\\n        CASE\\n            WHEN TRIM(ad_impressions) = 'null' THEN '0'\\n            ELSE ad_impressions\\n        END AS INT\\n    ) AS impressions,\\n\\n    CAST(\\n        CASE\\n            WHEN TRIM(ad_clicks) = 'null' THEN '0'\\n            ELSE ad_clicks\\n        END AS INT\\n    ) AS ad_clicks,\\n\\n    CAST(ad_date AS DATE) AS ad_date\\n\\nFROM raw_source\", \"generated_at\": \"2026-10-20 00:34:18\"}, {\"unique_id\": \"model.cde_marketing_ad.stg_facebook_campaign\", \"invocation_id\": \"67be3f51-f833-40d2-9fc3-8952e9c29889\", \"name\": \"stg_facebook_campaign\", \"schema\": \"ads_staging\", \"status\": \"success\", \"execution_time\": 3.7, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n\\nwith raw_source as (\\n    select * from `bronze_production`.`cdc_staging`.`raw_facebook_campaign`\\n)\\n\\nselect \\ncampaign_id,\\ncampaign_name,\\nCAST(campaign_updated_at as TIMESTAMP_NTZ) AS campaign_updated_at\\nfrom raw_source\", \"generated_at\": \"2026-10-20 00:34:18\"}, {\"unique_id\": \"model.cde_marketing_ad.stg_facebook_new_account\", \"invocation_id\": \"67be3f51-f833-40d2-9fc3-8952e9c29889\", \"name\": \"stg_facebook_new_account\", \"schema\": \"ads_staging\", \"status\": \"success\", \"execution_time\": 3, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n\\nwith raw_sources as(\\n    select * from `bronze_production`.`cdc_staging`.`raw_facebook_new_account`\\n)\\n\\nselect \\naccount_id,\\naccount_name,\\nad_currency_code,\\nCAST(account_created_at as TIMESTAMP_NTZ) AS account_created_at,\\nCAST(account_updated_at as TIMESTAMP_NTZ) AS account_updated_at\\n\\nfrom raw_sources\", \"generated_at\": \"2026-10-20 00:34:18\"}, {\"unique_id\": \"model.cde_marketing_ad.stg_snapchat_ad_group\", \"invocation_id\": \"67be3f51-f833-40d2-9fc3-8952e9c29889\", \"name\": \"stg_snapchat_ad_group\", \"schema\": \"ads_staging\", \"status\": \"success\", \"execution_time\": 3.7, \"full_refresh\": false, \"materialization\": \"view\", \"compiled_code\": \"\\n\\nwith raw_source as (\\n    select * from `bronze_production`.`cdc_staging`.`raw_snapchat_ad_group`\\n)\\n\\nSelect \\n_surrogate_key,\\nad_group_id,\\ncampaign_id,\\nad_group_name,\\nCAST(ad_group_updated_at as TIMESTAMP_NTZ) AS ad_group_updated_at\\nfrom raw_source\", \"generated_at\": \"2026-10-20 00:34:18\"}, {\"unique_id\": \"model.cde_marketing_ad.stg_snapchat_ad_names\", \"invocation_id\": \"67be3f
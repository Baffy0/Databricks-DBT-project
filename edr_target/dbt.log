{"data": {"conn_name": "macro_log_macro_results", "sql": "/* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"b62bfdec-9325-41d4-ad43-2917b1277e13\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"b62bfdec-9325-41d4-ad43-2917b1277e13\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n        with dbt_artifacts_seeds as (\n          select\n            name,\n            unique_id,\n            database_name,\n            schema_name,\n            case when alias is not null then alias\n            else name end as table_name,\n            owner as owners,\n            tags,\n            package_name,\n            description,\n            original_path as full_path\n          from `cde_development`.`elementary`.`dbt_seeds`\n        )\n\n        select * from dbt_artifacts_seeds\n  \n\n  "}, "info": {"category": "", "code": "E016", "extra": {}, "invocation_id": "b62bfdec-9325-41d4-ad43-2917b1277e13", "level": "debug", "msg": "On macro_log_macro_results: /* {\"app\": \"dbt\", \"dbt_version\": \"1.12.5\", \"dbt_databricks_version\": \"1.12.7\", \"databricks_sql_connector_version\": \"4.4.0\", \"profile_name\": \"elementary\", \"target_name\": \"dev\", \"invocation_id\": \"b62bfdec-9325-41d4-ad43-2917b1277e13\", \"connection_name\": \"macro_log_macro_results\"} */\n\n    \n    /* --ELEMENTARY-METADATA-- {\"command\": \"run-operation\", \"elementary_component\": \"OSS\", \"invocation_id\": \"b62bfdec-9325-41d4-ad43-2917b1277e13\", \"package_name\": \"elementary\", \"resource_name\": \"log_macro_results\", \"resource_type\": \"macro\"} --END-ELEMENTARY-METADATA-- */\n    \n      